[Unit]
Description=Cortex Core — Wearable AI Memory
After=bluetooth.target sound.target network-online.target
Wants=bluetooth.target sound.target network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/turfptax/cortex-core/src
Environment=PYTHONUNBUFFERED=1
# Slice 12.1 (2026-05-09): CORTEX_DEBUG=1 turns on debug.py event ring
# buffer + INFO-level emission to journalctl. Set to 0 (or remove this
# line) once the button + LCD UX is verified working — debug logging is
# a non-trivial chatty footprint on a 416 MB Pi.
# Toggle without editing this file:
#   sudo systemctl set-environment CORTEX_DEBUG=0  (or 1)
#   sudo systemctl restart cortex-core
# Slice 12.1.2: CORTEX_DEBUG=1 enables the cortex.dbg ring-buffer + journal
# events (button events, state transitions, render timing, STT backend,
# loop slowness). Default off in production — flip to 1 when investigating
# a specific issue, then back to 0 once it's resolved.
Environment=CORTEX_DEBUG=0
# Slice 12.1.2 (.132 only — pi zero 2w companion): the 8BitDo gamepad
# isn't paired with this device, and gamepad.poll() runs a blocking
# bluetoothctl scan every ~13s that freezes the main loop for 5-13s
# at a time (= recording-screen timer only updates once every 10s).
# Set to 0 here so .132 skips the scan entirely. Remove this line on
# any device that actually uses the gamepad.
Environment=CORTEX_GAMEPAD_ENABLED=0
ExecStart=/usr/bin/python3 /home/turfptax/cortex-core/src/main.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

# Slice 12 (2026-05-09): keep cortex-core alive under memory pressure
# on the Pi Zero 2W companion device (.132 has only ~416 MB RAM).
# Negative oom_score_adj tells the kernel to prefer killing OTHER
# processes first when a global OOM event hits. Verified live —
# process oom_score went from 668 → 475 with this setting. Don't
# add MemoryMax/MemoryHigh here — those would actively throttle/kill
# cortex-core, which is the OPPOSITE of intent.
OOMScoreAdjust=-500

[Install]
WantedBy=multi-user.target
